<Window
    x:Class="AIUsageMonitor.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:AIUsageMonitor.Desktop.ViewModels"
    xmlns:converters="clr-namespace:AIUsageMonitor.Desktop.Converters"
    Title="AI_Orchestrator"
    Icon="/Assets/apo-icon.ico"
    Width="1180"
    Height="760"
    MinWidth="860"
    MinHeight="580"
    Background="{StaticResource BrandDeepNavyBrush}"
    Foreground="{StaticResource BrandTextBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <Style x:Key="WorkspaceNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandSurfaceRaisedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:MissionControlViewModel}">
            <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MISSION CONTROL" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="One truthful view of project progress" Margin="0,8,0,0" Style="{StaticResource DisplayTitleStyle}" FontSize="27" />
                            <TextBlock Text="Evidence first. Unknown stays visible until an authoritative source says more." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RefreshStateText}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding LastEvidenceText}" HorizontalAlignment="Right" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh Mission Control" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PROJECT" VerticalAlignment="Center" Style="{StaticResource EyebrowTextStyle}" />
                            <ComboBox Grid.Column="1" Margin="16,0,16,0" ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" DisplayMemberPath="DisplayText" Style="{StaticResource BrandComboBoxStyle}" AutomationProperties.Name="Mission Control project selector" />
                            <Border Grid.Column="2" Style="{StaticResource StatusChipStyle}" Padding="10,6">
                                <TextBlock Text="{Binding OverallStateText}" Foreground="{StaticResource BrandTextBrush}" FontWeight="SemiBold" AutomationProperties.Name="Mission Control overall state" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="22" Visibility="{Binding ShowStorageUnavailableState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="DEGRADED MODE" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Mission Control is usable, but persisted orchestration truth is unavailable." Margin="0,8,0,0" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="{Binding StateReasonText}" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="22" Visibility="{Binding ShowSelectProjectState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="SELECT A PROJECT" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Mission Control will not guess between multiple active projects." Margin="0,8,0,0" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="Choose a project above to load its project-scoped evidence." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="CURRENT WORK" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{Binding CurrentWorkText}" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="{Binding CurrentStepText}" Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="Next safe action" Margin="0,16,0,0" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{Binding NextSafeActionText}" Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="STATE REASON" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{Binding StateReasonText}" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="Last evidence" Margin="0,16,0,0" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{Binding LastEvidenceText}" Margin="0,5,0,0" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="20" Visibility="{Binding HasAttention, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="OWNER ATTENTION" Style="{StaticResource EyebrowTextStyle}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding AttentionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="9">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Reason}" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding NextSafeAction, StringFormat=Next safe action: {0}}" Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding Source, StringFormat=Source: {0}}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Expander Margin="0,16,0,0" Header="Evidence &amp; details" IsExpanded="True" AutomationProperties.Name="Mission Control evidence and details">
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="ROLES" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding RolesText}" Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" />
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Snapshot.Roles.Assignments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Role}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource BrandTextBrush}" />
                                                        <TextBlock Text="{Binding DisplayName, StringFormat={}{0} — configured}" Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="REPOSITORY / TRACKER" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding RepositoryText}" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding TrackerText}" Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="QUALITY / APPROVAL" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding ValidationText}" Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ReviewText}" Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ApprovalText}" Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="RUNTIME / PROCESS" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding RuntimeText}" Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding Snapshot.Runtime.ProcessEvidenceText}" Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding HasLimitations, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="LIMITATIONS" Style="{StaticResource EyebrowTextStyle}" />
                                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Limitations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}" Margin="0,0,0,6" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AiCapacityViewModel}">
            <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AI CAPACITY" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Provider connections, usage and remaining capacity" Margin="0,8,0,0" Style="{StaticResource DisplayTitleStyle}" FontSize="27" />
                            <TextBlock Text="Five approved provider surfaces, with unknown values kept explicit." Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RefreshStateText}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding LastRefreshText}" HorizontalAlignment="Right" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <Button Content="Refresh all" Command="{Binding RefreshAllCommand}" AutomationProperties.Name="Refresh all AI providers" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl Margin="0,22,0,0" ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,16,16" Style="{StaticResource CardStyle}" MinHeight="240">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionHeadingStyle}" />
                                                <TextBlock Text="{Binding Code}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" Padding="9,5">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrandTextBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding StatusDetail}" Margin="0,13,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />

                                        <StackPanel Grid.Row="2" Margin="0,14,0,14">
                                            <StackPanel Visibility="{Binding AccountDisplayName, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="ACCOUNT" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="{Binding AccountDisplayName}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SubscriptionText, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,9,0,0">
                                                <TextBlock Text="SUBSCRIPTION" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="{Binding SubscriptionText}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding QuotaWindows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,7,0,0" Padding="10" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="9">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource BrandTextBrush}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding RemainingText}" Foreground="{StaticResource BrandTealBrush}" FontWeight="SemiBold" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding UsageText}" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                                                                <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="5" Margin="0,8,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding ResetText}" Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" />
                                                                <TextBlock Text="{Binding SourceText}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CredentialStateText}" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding LastSuccessfulRefreshText}" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh provider" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Content="Connect / edit" Command="{Binding EditCommand}" AutomationProperties.Name="Connect or edit provider" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Visibility="{Binding CanEditConnection, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectOnboardingViewModel}">
            <DataTemplate.Resources>
                <Style x:Key="OnboardingInputTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Background" Value="{StaticResource BrandNavyBlueBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="FontFamily" Value="{StaticResource BrandBodyFontFamily}" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
            </DataTemplate.Resources>
            <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NEW PROJECT" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="A useful project in four short steps" Margin="0,7,0,0" Style="{StaticResource DisplayTitleStyle}" FontSize="25" />
                            <TextBlock Text="Optional integrations stay explicit and unverified until a later capability proves them." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Top" Padding="10,6">
                            <TextBlock Text="{Binding StepNumber, StringFormat=Step {0} of 4}" Foreground="{StaticResource BrandTextBrush}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,20,0,0">
                        <Border Margin="0,0,6,0" Padding="8" CornerRadius="8" Background="{StaticResource BrandSurfaceRaisedBrush}">
                            <TextBlock Text="1  Project" Style="{StaticResource CaptionTextStyle}" />
                        </Border>
                        <Border Margin="0,0,6,0" Padding="8" CornerRadius="8" Background="{StaticResource BrandNavyBlueBrush}">
                            <TextBlock Text="2  Repository" Style="{StaticResource CaptionTextStyle}" />
                        </Border>
                        <Border Margin="0,0,6,0" Padding="8" CornerRadius="8" Background="{StaticResource BrandNavyBlueBrush}">
                            <TextBlock Text="3  Tracker" Style="{StaticResource CaptionTextStyle}" />
                        </Border>
                        <Border Padding="8" CornerRadius="8" Background="{StaticResource BrandNavyBlueBrush}">
                            <TextBlock Text="4  AI roles" Style="{StaticResource CaptionTextStyle}" />
                        </Border>
                    </UniformGrid>

                    <Border Margin="0,16,0,0" Padding="18" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <StackPanel Visibility="{Binding IsProjectStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="PROJECT" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Name the workspace and choose its local folder." Margin="0,7,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="These two fields are enough to create the project; advanced settings remain optional." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="PROJECT NAME" Margin="0,18,0,5" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OnboardingInputTextBoxStyle}" AutomationProperties.Name="Onboarding project name" />
                                <TextBlock Text="LOCAL WORKSPACE PATH" Margin="0,14,0,5" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBox Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OnboardingInputTextBoxStyle}" AutomationProperties.Name="Onboarding local workspace path" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsRepositoryStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="REPOSITORY" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Inspect local Git safely, then choose what to retain." Margin="0,7,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Inspection is read-only and local. It does not read file contents, contact a remote, fetch, pull, or push." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Inspect local repository" Command="{Binding InspectRepositoryCommand}" AutomationProperties.Name="Inspect local repository" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="Continue without repository integration" Command="{Binding SkipRepositoryCommand}" Margin="8,0,0,0" AutomationProperties.Name="Continue without repository integration" Style="{StaticResource GhostButtonStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding RepositoryStatusText}" Margin="0,16,0,0" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="ROOT" Style="{StaticResource ProjectFieldLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding RepositoryRootText}" Margin="16,0,0,6" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="1" Text="BRANCH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RepositoryBranchText}" Margin="16,0,0,6" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="2" Text="REMOTE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RepositoryRemoteText}" Margin="16,0,0,6" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="3" Text="CAPTURED" Style="{StaticResource ProjectFieldLabelStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RepositoryCapturedAtText}" Margin="16,0,0,0" Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <TextBlock Text="A default branch is proposed only from a normal current branch. Detached or unborn repositories require an explicit branch or skip." Margin="0,14,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                <TextBox Text="{Binding RepositoryDefaultBranch, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" Style="{StaticResource OnboardingInputTextBoxStyle}" AutomationProperties.Name="Repository default branch for onboarding" ToolTip="Only needed when no usable current branch was detected" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Accept detected metadata" Command="{Binding AcceptRepositoryCommand}" AutomationProperties.Name="Accept detected repository metadata" Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock Text="{Binding RepositoryDecisionText}" Margin="12,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsTrackerStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="TRACKER" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Keep a bounded reference, or skip setup for now." Margin="0,7,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="No tracker API, OAuth, PAT, browser, or CLI call is made during onboarding." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="TRACKER OPTION" Margin="0,18,0,5" Style="{StaticResource EyebrowTextStyle}" />
                                <ComboBox ItemsSource="{Binding TrackerOptions}" SelectedItem="{Binding SelectedTrackerOption}" Style="{StaticResource ProjectInputComboBoxStyle}" AutomationProperties.Name="Onboarding tracker option" />
                                <TextBlock Text="REFERENCE / PROJECT KEY" Margin="0,14,0,5" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBox Text="{Binding TrackerReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OnboardingInputTextBoxStyle}" AutomationProperties.Name="Onboarding tracker reference" />
                                <TextBlock Text="{Binding TrackerStateText}" Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsAgentsStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="AI ROLES" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Review the approved defaults for this project." Margin="0,7,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="All six roles start enabled. Disabling one creates only a project-scoped restriction; global definitions and access truth are unchanged." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                <ItemsControl ItemsSource="{Binding AgentOptions}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10" Margin="0,0,0,8" Background="{StaticResource BrandDeepNavyBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" AutomationProperties.Name="Enable project AI role" />
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding RolesText}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                                        <TextBlock Text="{Binding AccessTruthText}" Margin="0,3,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrandErrorBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel project onboarding" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Back" Command="{Binding BackCommand}" AutomationProperties.Name="Back in project onboarding" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Next" Command="{Binding NextCommand}" AutomationProperties.Name="Next in project onboarding" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="Finish" Command="{Binding FinishCommand}" AutomationProperties.Name="Finish project onboarding" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
            <DataTemplate.Resources>
                <Style x:Key="ProjectInputTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Background" Value="{StaticResource BrandNavyBlueBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="9,7" />
                    <Setter Property="FontFamily" Value="{StaticResource BrandBodyFontFamily}" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
                <Style x:Key="ProjectInputComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource BrandComboBoxStyle}" />

                <Style x:Key="ProjectRegistryListBoxStyle" TargetType="ListBox">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="Transparent" BorderThickness="0">
                                    <ScrollViewer
                                        Focusable="False"
                                        VerticalScrollBarVisibility="{Binding Path=(ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                                        HorizontalScrollBarVisibility="{Binding Path=(ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ProjectFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EyebrowTextStyle}">
                    <Setter Property="Foreground" Value="{StaticResource BrandMutedTextBrush}" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                </Style>
            </DataTemplate.Resources>

            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PROJECTS" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Registered workspaces and project lifecycle" Margin="0,8,0,0" Style="{StaticResource DisplayTitleStyle}" FontSize="27" />
                        <TextBlock Text="Keep project metadata visible, isolated, and ready for the next approved step." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh projects" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="New project" Command="{Binding NewProjectCommand}" AutomationProperties.Name="New project" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid Visibility="{Binding ShowLoadingState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}" Padding="24" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="LOADING REGISTRY" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Loading registered projects…" Margin="0,9,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="The workspace remains responsive while local project metadata is read." Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding ShowStorageUnavailableState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}" Padding="24" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="STORAGE UNAVAILABLE" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource BrandWarningBrush}" />
                                <TextBlock Text="Project storage is unavailable." Margin="0,9,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Projects remain read-only until LocalAppData storage is available. No alternate registry is being used." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding ShowLoadErrorState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}" Padding="24" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="REGISTRY READ FAILED" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource BrandWarningBrush}" />
                                <TextBlock Text="Projects could not be loaded." Margin="0,9,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Retry the local registry read. Existing editor input, if any, is not discarded." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                <Button Content="Retry" Command="{Binding RefreshCommand}" AutomationProperties.Name="Retry loading projects" Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding ShowRegistrySurface, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.1*" MinWidth="295" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="REGISTRY" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="Projects" Margin="0,5,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Projects.Count, StringFormat={}{0} total}" VerticalAlignment="Bottom" Style="{StaticResource CaptionTextStyle}" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRegistryInteractionEnabled}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Search projects" ToolTip="Search by project name or local path" />
                                    <ComboBox Grid.Row="1" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" IsEnabled="{Binding IsRegistryInteractionEnabled}" Style="{StaticResource ProjectInputComboBoxStyle}" AutomationProperties.Name="Filter projects by status" Margin="0,8,0,0" />

                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <StackPanel Visibility="{Binding ShowEmptyRegistryState, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="NO PROJECTS YET" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBlock Text="No projects registered yet." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SectionHeadingStyle}" />
                                            <TextBlock Text="Register a workspace to make its lifecycle and governance metadata visible here." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                            <Button Content="New project" Command="{Binding NewProjectCommand}" AutomationProperties.Name="New project from empty state" Margin="0,16,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ShowNoMatchState, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="NO MATCHES" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBlock Text="No projects match this filter." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SectionHeadingStyle}" />
                                            <TextBlock Text="Try another search or choose All in the status filter." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <ListBox Grid.Row="3" ItemsSource="{Binding FilteredProjects}" SelectedItem="{Binding SelectedProjectCard, Mode=TwoWay}" IsEnabled="{Binding IsRegistryInteractionEnabled}" Style="{StaticResource ProjectRegistryListBoxStyle}" Margin="0,14,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Registered projects">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,9" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ProjectCardBorder" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="ProjectCardBorder" Property="Background" Value="{StaticResource BrandSurfaceRaisedBrush}" />
                                                                    <Setter TargetName="ProjectCardBorder" Property="BorderBrush" Value="{StaticResource BrandCyanBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="ProjectCardBorder" Property="BorderBrush" Value="{StaticResource BrandSoftGlowBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Style="{StaticResource SectionHeadingStyle}" />
                                                        <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" Padding="7,4" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource BrandTextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding LocalPath}" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                    <TextBlock Text="{Binding RepositorySummary}" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                    <TextBlock Text="{Binding TrackerSummary}" Margin="0,3,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                    <TextBlock Text="{Binding UpdatedAtText, StringFormat=Updated {0}}" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditorVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsOnboardingVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SELECTED PROJECT" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Project details" Margin="0,5,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Edit" Command="{Binding EditProjectCommand}" AutomationProperties.Name="Edit selected project" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>

                                        <StackPanel Visibility="{Binding HasSelectedProject, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,18,0,0">
                                            <TextBlock Text="{Binding SelectedProject.Name}" Style="{StaticResource DisplayTitleStyle}" FontSize="24" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding SelectedProject.Status}" Foreground="{StaticResource BrandTextBrush}" FontWeight="SemiBold" />
                                            </Border>

                                            <Grid Margin="0,22,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="LOCAL PATH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedProject.LocalPath}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="1" Text="REPOSITORY PROVIDER" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProject.RepositoryProvider, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="2" Text="REPOSITORY URL" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                 <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRepositoryUrlDisplay}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="3" Text="REPOSITORY ID" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProject.RepositoryId, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="4" Text="DEFAULT BRANCH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProject.DefaultBranch, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="5" Text="TRACKER TYPE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProject.TrackerType, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="6" Text="TRACKER ID" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedProject.TrackerId, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="7" Text="GOVERNANCE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedGovernanceReferencesDisplay}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="8" Text="ROUTING POLICY" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedProject.RoutingPolicyReference, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="9" Text="SAFETY POLICY" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedProject.SafetyPolicyReference, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="10" Text="CREATED / UPDATED" Style="{StaticResource ProjectFieldLabelStyle}" />
                                             <StackPanel Grid.Row="10" Grid.Column="1" Margin="16,0,0,10">
                                                    <TextBlock Text="{Binding SelectedCreatedAtText, StringFormat=Created {0}}" Style="{StaticResource BodyTextStyle}" />
                                                    <TextBlock Text="{Binding SelectedUpdatedAtText, StringFormat=Updated {0}}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Margin="0,14,0,0" Padding="14" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="REPOSITORY VERIFICATION" Style="{StaticResource EyebrowTextStyle}" />
                                                            <TextBlock Text="Local evidence" Margin="0,5,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Content="Verify repository" Command="{Binding VerifyRepositoryCommand}" AutomationProperties.Name="Verify repository" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding ShowRepositoryStateDetails, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                            <Button Content="Refresh repository state" Command="{Binding RefreshRepositoryStateCommand}" AutomationProperties.Name="Refresh repository state" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding ShowRepositoryStateDetails, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding RepositoryVerificationStatusText}" Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding RepositoryVerificationErrorText}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrandErrorBrush}" Visibility="{Binding HasRepositoryState, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <Grid Margin="0,14,0,0" Visibility="{Binding ShowRepositoryStateDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="BRANCH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RepositoryBranchText}" Margin="16,0,0,8" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="1" Text="HEAD" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RepositoryHeadText}" Margin="16,0,0,8" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="2" Text="UPSTREAM" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RepositoryUpstreamText}" Margin="16,0,0,8" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="3" Text="ROOT RELATIONSHIP" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RepositoryRootRelationshipText}" Margin="16,0,0,8" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="4" Text="REPOSITORY ROOT" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RepositoryRootText}" Margin="16,0,0,8" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="5" Text="WORKING TREE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RepositoryWorkingTreeText}" Margin="16,0,0,8" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="6" Text="CAPTURED" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RepositoryCapturedAtText}" Margin="16,0,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                    </Grid>

                                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowRepositoryStateDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="CONFIGURED REMOTES" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                        <TextBlock Text="{Binding RepositoryRemoteComparisonText}" Margin="0,0,0,6" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                        <TextBlock Text="No configured remotes" Style="{StaticResource CaptionTextStyle}" Visibility="{Binding HasRepositoryRemotes, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                        <ItemsControl ItemsSource="{Binding RepositoryState.Remotes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,4,0,0" Padding="9" Background="{StaticResource BrandDeepNavyBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="7">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding SanitizedUrl}" Margin="0,3,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowChangedFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="CHANGED FILES" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                        <TextBlock Text="{Binding ChangedFilesSummaryText}" Margin="0,0,0,6" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                        <ListBox ItemsSource="{Binding ChangedFiles}" MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Changed files">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,2">
                                                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource BrandWarningBrush}" />
                                                                        <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                                        <TextBlock Text="{Binding OriginalRelativePath, StringFormat=Renamed from {0}}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Visibility="{Binding OriginalRelativePath, Converter={StaticResource NullToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Registration stores metadata only. Verify repository performs local, read-only inspection and does not contact a remote service." Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding HasSelectedProject, Converter={StaticResource InverseBoolToVisibilityConverter}}" Margin="0,22,0,0">
                                            <TextBlock Text="Choose a project" Style="{StaticResource SectionHeadingStyle}" />
                                            <TextBlock Text="Select a registered workspace to inspect its metadata, or use New project to add one." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="PROJECT REGISTRATION" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="{Binding EditorTitle}" Margin="0,5,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Cancel" Command="{Binding CancelEditCommand}" AutomationProperties.Name="Cancel project edit" Style="{StaticResource GhostButtonStyle}" />
                                                <Button Content="Save changes" Command="{Binding SaveProjectCommand}" AutomationProperties.Name="Save project" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding SavingStateText}" Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ValidationMessage}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrandWarningBrush}" Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrandErrorBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="NAME" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Project name" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="STATUS" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding ProjectStatusOptions}" SelectedItem="{Binding EditorStatus}" Style="{StaticResource ProjectInputComboBoxStyle}" AutomationProperties.Name="Project lifecycle status" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                                <TextBlock Text="LOCAL PATH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorLocalPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Project local path" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                                <TextBlock Text="REPOSITORY PROVIDER" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorRepositoryProvider, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Repository provider" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                                <TextBlock Text="REPOSITORY URL" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorRepositoryUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Repository URL" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
                                                <TextBlock Text="REPOSITORY ID" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorRepositoryId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Repository ID" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
                                                <TextBlock Text="DEFAULT BRANCH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorDefaultBranch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Repository default branch" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,12,0,0">
                                                <TextBlock Text="TRACKER TYPE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorTrackerType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Tracker type" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,12,0,0">
                                                <TextBlock Text="TRACKER ID" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorTrackerId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Tracker ID" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                                <TextBlock Text="GOVERNANCE REFERENCES" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorGovernanceReferencesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Governance references, one per line" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto" ToolTip="One reference per line" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,12,0,0">
                                                <TextBlock Text="ROUTING POLICY REFERENCE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorRoutingPolicyReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Routing policy reference" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,12,0,0">
                                                <TextBlock Text="SAFETY POLICY REFERENCE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorSafetyPolicyReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Safety policy reference" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Registration stores metadata only. APO does not check the path, Git, tracker authentication, or repository connectivity in this workspace." Margin="0,18,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ContentControl Content="{Binding Onboarding}" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" Padding="7" Background="{StaticResource BrandSurfaceRaisedBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Image Source="/Assets/apo-icon.ico" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AI PROJECT ORCHESTRATOR" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Intelligent project &amp; AI execution control" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource BrandTealBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="CAPACITY READY" Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="18,22" Background="{StaticResource BrandDeepNavyBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Command surfaces" Margin="0,5,0,0" Style="{StaticResource SectionHeadingStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <Button Tag="{Binding IsMissionControlSelected}" Command="{Binding ShowMissionControlCommand}" AutomationProperties.Name="Mission Control" Style="{StaticResource WorkspaceNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="◈" FontSize="17" Foreground="{StaticResource BrandCyanBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Mission Control" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Tag="{Binding IsProjectsSelected}" Command="{Binding ShowProjectsCommand}" AutomationProperties.Name="Projects" Style="{StaticResource WorkspaceNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="□" FontSize="17" Foreground="{StaticResource BrandVioletBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Projects" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Tag="{Binding IsAiCapacitySelected}" Command="{Binding ShowAiCapacityCommand}" AutomationProperties.Name="AI capacity" Style="{StaticResource WorkspaceNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="▰" FontSize="16" Foreground="{StaticResource BrandCyanBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="AI capacity" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button AutomationProperties.Name="Agents (planned)" IsEnabled="False" Style="{StaticResource NavigationItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="◇" FontSize="17" Foreground="{StaticResource BrandPurpleBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Agents" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="SOON" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button AutomationProperties.Name="Activity (planned)" IsEnabled="False" Style="{StaticResource NavigationItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="≡" FontSize="19" Foreground="{StaticResource BrandTealBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Activity" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="SOON" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="2" Padding="12" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="SCOPE NOTE" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Future surfaces stay visibly quiet until their capability is real." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding ActiveWorkspace}" />
        </Grid>
    </Grid>
</Window>
