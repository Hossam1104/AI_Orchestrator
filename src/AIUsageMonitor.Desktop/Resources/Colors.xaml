<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- AI Orchestrator light palette. These semantic tokens mirror the accepted
         RMS Support Hub family: cool canvas, white surfaces, cyan primary action,
         violet focus, and explicit status surfaces. -->
    <Color x:Key="CanvasColor">#F2F6F8</Color>
    <Color x:Key="ShellColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#EAF1F4</Color>
    <Color x:Key="SurfaceHoverColor">#E5F6F5</Color>
    <Color x:Key="SurfaceSelectedColor">#D8F2F0</Color>
    <Color x:Key="SurfaceDisabledColor">#E9EEF0</Color>
    <Color x:Key="BorderColor">#D5E1E6</Color>
    <Color x:Key="HeroColor">#E7F7F6</Color>
    <Color x:Key="HeroBorderColor">#B7DFDE</Color>
    <Color x:Key="TextPrimaryColor">#17324A</Color>
    <Color x:Key="TextSecondaryColor">#486476</Color>
    <Color x:Key="TextMutedColor">#708795</Color>
    <Color x:Key="TextDisabledColor">#9BAAB3</Color>
    <Color x:Key="AccentColor">#12B8B0</Color>
    <Color x:Key="AccentHoverColor">#0EA39D</Color>
    <Color x:Key="AccentPressedColor">#087F7B</Color>
    <Color x:Key="AccentSecondaryColor">#715BD6</Color>
    <Color x:Key="AccentVioletColor">#7B61FF</Color>
    <Color x:Key="AccentBlueColor">#5B8CF5</Color>
    <Color x:Key="AccentTurquoiseColor">#47C7B1</Color>
    <Color x:Key="AccentCyanColor">#65C8D0</Color>
    <Color x:Key="PrimaryCyanColor">#1FAFC3</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#16865C</Color>
    <Color x:Key="WarningColor">#B66A08</Color>
    <Color x:Key="ErrorColor">#C6424F</Color>
    <Color x:Key="ErrorHoverColor">#A63340</Color>
    <Color x:Key="ErrorPressedColor">#862731</Color>
    <Color x:Key="InfoColor">#4777C7</Color>
    <Color x:Key="StatusNeutralColor">#738592</Color>
    <Color x:Key="SuccessSurfaceColor">#E5F5EE</Color>
    <Color x:Key="WarningSurfaceColor">#FFF3DD</Color>
    <Color x:Key="ErrorSurfaceColor">#FDEBED</Color>
    <Color x:Key="InfoSurfaceColor">#EAF1FF</Color>
    <Color x:Key="FocusRingColor">#715BD6</Color>
    <Color x:Key="ShadowColor">#17324A</Color>
    <Color x:Key="ScrollBarTrackColor">#D8E2E7</Color>
    <sys:String x:Key="ThemeVariant">Light</sys:String>
</ResourceDictionary>
